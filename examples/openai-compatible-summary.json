{
  "version": 2,
  "api": {
    "listen": "127.0.0.1:8010",
    "metrics_enabled": true
  },
  "database": {
    "url_env": "LLM_BROKER_DATABASE_URL",
    "migration_url_env": "LLM_BROKER_MIGRATION_DATABASE_URL",
    "provisioner_url_env": "LLM_BROKER_PROVISIONER_DATABASE_URL",
    "max_connections": 10
  },
  "retention": {
    "payload": "1h",
    "result": "168h",
    "metadata": "720h"
  },
  "backends": {
    "provider": {
      "type": "openai_compatible",
      "base_url": "http://inference-runtime:8001/v1",
      "model": "operator-model-alias",
      "credential_env": "LLM_BACKEND_API_KEY",
      "response_header_timeout_seconds": 60
    }
  },
  "capabilities": {
    "summarize": {
      "backend": "provider"
    }
  },
  "workloads": {
    "batch-summary": {
      "priority_class": "normal",
      "max_active_tasks": 10,
       "max_attempts": 1,
       "retry_delays_seconds": [],
       "max_output_tokens": 1024,
       "max_output_bytes": 16384,
      "allowed_generation": {
         "max_tokens": { "max": 1024 },
        "temperature": { "min": 0, "max": 2 }
      },
      "required_features": [],
      "allowed_capabilities": ["summarize"],
      "workload_timeout_seconds": 300
    }
  }
}
